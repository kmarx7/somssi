# SOMSSI local environment
# Fill these values from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Never expose this with NEXT_PUBLIC_ or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Keep Mock Payment enabled for local development until a real PG is connected.
SOMSSI_ALLOW_MOCK_PAYMENT=true
